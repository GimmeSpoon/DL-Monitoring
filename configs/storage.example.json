{
  "connections": {
    "gpu-1-host": { "addr": "10.0.0.2", "port": 22, "username": "hostadmin", "privateKey": "~/.ssh/host_key" },
    "infer-box": { "addr": "10.0.0.50", "port": 22, "username": "root" },
    "local": { "local": true }
  },
  "targets": [
    { "scope": "server-a", "connection": "gpu-1-host", "type": "accounts", "roots": ["/home"], "sudo": true },
    { "scope": "server-a", "connection": "gpu-1-host", "type": "containers", "sudo": true, "layers": ["writable", "mounts"], "everyHours": 2 },
    { "scope": "server-a", "connection": "gpu-1-host", "type": "paths", "label": "Datasets", "paths": ["/data/datasets", "/data/models"] },
    { "scope": "infer-box", "connection": "infer-box", "type": "containers", "engine": "podman", "layers": ["writable"] },
    { "scope": "infer-box", "connection": "infer-box", "type": "accounts", "roots": ["/srv/users"], "strategy": "quota" },
    { "scope": "local", "connection": "local", "type": "command", "label": "Model cache", "command": "du -sb ~/.cache/huggingface" }
  ]
}
